{
  "name": "lambda-logo-calculus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build && pnpm --filter @trefoil/studio build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "parity:record": "node scripts/record-parity.mjs",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/render-svg/tsconfig.json && tsc --noEmit -p apps/studio/tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "dev": "pnpm --filter @trefoil/studio dev",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@trefoil/core": "workspace:*",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.0.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  }
}
