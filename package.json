{
  "name": "trefoil-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build && pnpm --filter @trefoil/studio build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist apps/*/dist",
    "dev": "pnpm --filter @trefoil/studio dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:boundary": "node scripts/check-core-boundary.mjs",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "parity:record": "node scripts/record-parity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@trefoil/core": "workspace:*",
    "@trefoil/export": "workspace:*",
    "@trefoil/render-svg": "workspace:*",
    "@trefoil/store": "workspace:*",
    "@trefoil/templates": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.0.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.2"
  }
}
